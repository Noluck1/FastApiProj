{
  "name": "template-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "lint:ci": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,vue,scss,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,vue,scss,css,json,md}\"",
    "pre-push:check": "npm run lint:ci && npm run format:check && npm run type-check",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/zod": "^4.15.1",
    "@vue/devtools-api": "^8.1.5",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "~10.9.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.9.5",
    "sass": "^1.101.0",
    "shadcn-vue": "^2.8.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  }
}
